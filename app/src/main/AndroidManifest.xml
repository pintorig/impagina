<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Nessun permesso dichiarato, di proposito:
      - lo scanner ML Kit gira dentro Google Play Services, che usa i propri;
      - l'import file passa dallo Storage Access Framework;
      - il salvataggio usa ACTION_CREATE_DOCUMENT.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocumentoA4">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Serve a passare ad altre app un Uri leggibile sul file condiviso.
          exported=false: l'accesso è concesso una richiesta alla volta, tramite
          FLAG_GRANT_READ_URI_PERMISSION, non in modo permanente.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
